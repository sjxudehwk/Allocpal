        <Button 
          onClick={handleLogin}
          className="bg-slate-900 hover:bg-slate-800"
        >
          Get Started
        </Button>
      </header>

      {/* Hero Section */}
      <main className="max-w-7xl mx-auto px-6 pt-16 pb-24">
        <div className="text-center max-w-3xl mx-auto mb-16">
          <div className="inline-flex items-center gap-2 bg-slate-900 text-white px-4 py-2 rounded-full text-sm font-medium mb-6">
            <Sparkles className="w-4 h-4" />
            AI-Powered Task Distribution
          </div>
          <h1 className="text-5xl md:text-6xl font-bold text-slate-900 mb-6 leading-tight">
            Fair Group Projects,{' '}
            <span className="font-bold text-slate-900">
              Finally.
            </span>
          </h1>
          <p className="text-xl text-slate-600 mb-8">
            No more one person doing all the work. AllocPal uses AI to distribute tasks fairly, 
            track contributions, and ensure everyone pulls their weight.
