import React, { useState, useEffect } from 'react';
import { base44 } from '@/api/base44Client';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { BarChart3, RefreshCw, Loader2, CheckCircle, AlertTriangle, TrendingUp } from 'lucide-react';
import { Progress } from '@/components/ui/progress';

export default function ContributionPanel({ project, members, tasks }) {
  const [insights, setInsights] = useState(null);
  const [isLoading, setIsLoading] = useState(false);
  const [hasGenerated, setHasGenerated] = useState(false);

  const calculateMemberStats = () => {
    return members.map(member => {
      const memberTasks = tasks.filter(t => t.assigned_to === member.email);
      const completed = memberTasks.filter(t => t.status === 'completed').length;
      const inProgress = memberTasks.filter(t => t.status === 'in_progress').length;
      const total = memberTasks.length;
      
      return {
        ...member,
        tasksAssigned: total,
        tasksCompleted: completed,
        tasksInProgress: inProgress,
        completionRate: total > 0 ? Math.round((completed / total) * 100) : 0,
      };
    });
  };

  const generateInsights = async () => {
    setIsLoading(true);
    try {
      const memberStats = calculateMemberStats();
      
      const prompt = `Analyze this team's contribution and fairness in a group project.

Project: ${project.title}
Deadline: ${project.deadline}

Team Performance:
${memberStats.map(m => 
  `- ${m.name}: ${m.tasksCompleted}/${m.tasksAssigned} tasks completed (${m.completionRate}%)${m.skill ? `, Skill: ${m.skill}` : ''}`
).join('\n')}

Total Tasks: ${tasks.length}
Completed: ${tasks.filter(t => t.status === 'completed').length}
In Progress: ${tasks.filter(t => t.status === 'in_progress').length}
Not Started: ${tasks.filter(t => t.status === 'not_started').length}

Provide:
1. An overall fairness score (0-100)
2. A brief summary of contributions
3. Individual insights for each member
4. Any concerns about workload balance`;

      const response = await base44.integrations.Core.InvokeLLM({
        prompt,
        response_json_schema: {
          type: 'object',
          properties: {
            fairness_score: { type: 'number' },
            summary: { type: 'string' },
            member_insights: {
              type: 'array',
              items: {
                type: 'object',
                properties: {
                  name: { type: 'string' },
                  insight: { type: 'string' },
                  status: { type: 'string', enum: ['good', 'warning', 'concern'] }
                }
              }
            },
            concerns: { type: 'array', items: { type: 'string' } }
          }
        }
      });

      setInsights(response);
      setHasGenerated(true);
    } catch (error) {
      console.error('Failed to generate insights:', error);
    }
    setIsLoading(false);
  };

  const memberStats = calculateMemberStats();

  return (
    <Card>
      <CardHeader className="pb-3">
        <CardTitle className="flex items-center gap-2 text-lg">
          <BarChart3 className="w-5 h-5 text-slate-900" />
          Contribution & Fairness
        </CardTitle>
      </CardHeader>
      <CardContent className="space-y-4">
        {/* Member Stats */}
        <div className="space-y-3">
          {memberStats.map(member => (
            <div key={member.id} className="space-y-1">
              <div className="flex justify-between text-sm">
                <span className="font-medium text-slate-700">{member.name}</span>
                <span className="text-slate-500">
                  {member.tasksCompleted}/{member.tasksAssigned} tasks
                </span>
              </div>
              <Progress value={member.completionRate} className="h-2" />
            </div>
          ))}
        </div>

        {/* AI Insights */}
        {!hasGenerated ? (
          <Button 
            onClick={generateInsights} 
            disabled={isLoading}
            className="w-full bg-slate-900 hover:bg-slate-800"
          >
            {isLoading ? (
              <>
                <Loader2 className="w-4 h-4 mr-2 animate-spin" />
                Analyzing...
              </>
            ) : (
              <>
                <TrendingUp className="w-4 h-4 mr-2" />
                Generate AI Insights
              </>
            )}
          </Button>
        ) : insights ? (
          <div className="space-y-4 pt-3 border-t">
            {/* Fairness Score */}
            <div className="text-center p-4 bg-slate-50 rounded-xl">
              <div className="text-3xl font-bold text-slate-900 mb-1">
                {insights.fairness_score}/100
              </div>
              <div className="text-sm text-slate-600">Fairness Score</div>
            </div>

            {/* Summary */}
            <div className="text-sm text-slate-700 bg-slate-50 p-3 rounded-lg">
              {insights.summary}
            </div>

            {/* Member Insights */}
            {insights.member_insights && insights.member_insights.length > 0 && (
              <div className="space-y-2">
                <h4 className="text-sm font-medium text-slate-700">Individual Insights</h4>
                {insights.member_insights.map((item, i) => (
                  <div key={i} className={`text-sm p-2 rounded-lg flex items-start gap-2 ${
                    item.status === 'good' ? 'bg-emerald-50 text-emerald-700' :
                    item.status === 'warning' ? 'bg-amber-50 text-amber-700' :
                    'bg-red-50 text-red-700'
                  }`}>
                    {item.status === 'good' ? (
                      <CheckCircle className="w-4 h-4 mt-0.5 flex-shrink-0" />
                    ) : (
                      <AlertTriangle className="w-4 h-4 mt-0.5 flex-shrink-0" />
                    )}
                    <div>
                      <span className="font-medium">{item.name}:</span> {item.insight}
                    </div>
                  </div>
                ))}
              </div>
            )}

            {/* Concerns */}
            {insights.concerns && insights.concerns.length > 0 && (
              <div className="space-y-2">
                <h4 className="text-sm font-medium text-slate-700">Areas of Concern</h4>
                {insights.concerns.map((concern, i) => (
                  <div key={i} className="text-sm text-amber-700 bg-amber-50 p-2 rounded-lg flex items-start gap-2">
                    <AlertTriangle className="w-4 h-4 mt-0.5 flex-shrink-0" />
                    {concern}
                  </div>
                ))}
              </div>
            )}

            <Button 
              variant="outline" 
              size="sm"
              onClick={generateInsights}
              disabled={isLoading}
              className="w-full"
            >
              <RefreshCw className={`w-4 h-4 mr-2 ${isLoading ? 'animate-spin' : ''}`} />
              Refresh Insights
            </Button>
          </div>
        ) : null}
      </CardContent>
    </Card>
  );
}
