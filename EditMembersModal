import React, { useState, useEffect } from 'react';
import { base44 } from '@/api/base44Client';
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
} from '@/components/ui/dialog';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { Plus, Trash2, Loader2, AlertCircle, Save } from 'lucide-react';
import { Alert, AlertDescription } from '@/components/ui/alert';
import { Badge } from '@/components/ui/badge';

export default function EditMembersModal({ open, onClose, projectId, members, onSuccess }) {
  const [editedMembers, setEditedMembers] = useState([]);
  const [newMembers, setNewMembers] = useState([]);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [error, setError] = useState('');

  useEffect(() => {
    if (members) {
      setEditedMembers(members.map(m => ({ ...m, _action: 'keep' })));
      setNewMembers([]);
    }
  }, [members]);

  const updateMember = (index, field, value) => {
    const updated = [...editedMembers];
    updated[index][field] = value;
    if (updated[index]._action === 'keep') {
      updated[index]._action = 'update';
    }
    setEditedMembers(updated);
  };

  const markForDeletion = (index) => {
    const updated = [...editedMembers];
    if (updated[index].is_owner) {
      setError('Cannot delete the project owner');
      return;
    }
    updated[index]._action = updated[index]._action === 'delete' ? 'keep' : 'delete';
    setEditedMembers(updated);
    setError('');
  };

  const addNewMember = () => {
    setNewMembers([...newMembers, { name: '', email: '', skill: '' }]);
  };

  const updateNewMember = (index, field, value) => {
    const updated = [...newMembers];
    updated[index][field] = value;
    setNewMembers(updated);
  };

  const removeNewMember = (index) => {
    setNewMembers(newMembers.filter((_, i) => i !== index));
  };

  const handleSubmit = async () => {
    // Validate
    for (const member of editedMembers) {
      if (member._action !== 'delete' && (!member.name.trim() || !member.email.trim())) {
        setError('All members must have name and email');
        return;
      }
    }
    for (const member of newMembers) {
      if (!member.name.trim() || !member.email.trim()) {
        setError('All new members must have name and email');
        return;
      }
    }

    setIsSubmitting(true);
    setError('');

    try {
      // Update existing members
      for (const member of editedMembers) {
        if (member._action === 'update') {
          await base44.entities.ProjectMember.update(member.id, {
            name: member.name,
            email: member.email,
            skill: member.skill,
          });
        } else if (member._action === 'delete') {
          // Also delete tasks assigned to this member
          const memberTasks = await base44.entities.Task.filter({ 
            project_id: projectId,
            assigned_to: member.email 
          });
          for (const task of memberTasks) {
            await base44.entities.Task.delete(task.id);
          }
          await base44.entities.ProjectMember.delete(member.id);
        }
      }

      // Add new members and trigger task assignment
      for (const member of newMembers) {
        await base44.entities.ProjectMember.create({
          project_id: projectId,
          name: member.name,
          email: member.email,
          skill: member.skill,
          is_owner: false,
        });
      }

      // If new members were added, trigger AI to reassign tasks
      if (newMembers.length > 0) {
        try {
          const allMembers = await base44.entities.ProjectMember.filter({ project_id: projectId });
          const allTasks = await base44.entities.Task.filter({ project_id: projectId });
          
          if (allTasks.length > 0) {
            const project = await base44.entities.Project.filter({ id: projectId });
            const projectName = project[0]?.title || 'Project';

            const prompt = `You are a project management AI. New members were just added to this project. Reassign tasks fairly to balance the workload among all team members.

Project: ${projectName}

All Team Members:
${allMembers.map((m, i) => `${i + 1}. ${m.name} (${m.email})${m.skill ? ` - Skill: ${m.skill}` : ''}`).join('\n')}

Current Tasks:
${allTasks.map((t, i) => `${i + 1}. ${t.title} - Currently assigned to: ${t.assigned_name} - Status: ${t.status}`).join('\n')}

Requirements:
- Reassign tasks to balance workload across all members
- Consider skills if available
- Try to give each member at least one task
- Don't reassign completed tasks
- Prioritize reassigning tasks that are not started yet

Return the updated task assignments.`;

            const response = await base44.integrations.Core.InvokeLLM({
              prompt,
              response_json_schema: {
                type: 'object',
                properties: {
                  assignments: {
                    type: 'array',
                    items: {
                      type: 'object',
                      properties: {
                        task_title: { type: 'string' },
                        assigned_email: { type: 'string' },
                        assigned_name: { type: 'string' }
                      }
                    }
                  }
                }
              }
            });

            if (response.assignments && response.assignments.length > 0) {
              for (const assignment of response.assignments) {
                const taskToUpdate = allTasks.find(t => t.title === assignment.task_title);
                if (taskToUpdate && taskToUpdate.status !== 'completed') {
                  await base44.entities.Task.update(taskToUpdate.id, {
                    assigned_to: assignment.assigned_email,
                    assigned_name: assignment.assigned_name
                  });
                }
              }
            }
          }
        } catch (aiError) {
          console.error('AI task assignment failed:', aiError);
          // Members still added successfully
        }
      }

      onSuccess();
      onClose();
    } catch (err) {
      setError('Failed to update members. Please try again.');
    }
    setIsSubmitting(false);
  };

  return (
    <Dialog open={open} onOpenChange={onClose}>
      <DialogContent className="sm:max-w-2xl max-h-[90vh] overflow-y-auto">
        <DialogHeader>
          <DialogTitle>Manage Team Members</DialogTitle>
        </DialogHeader>

        {error && (
          <Alert variant="destructive" className="mb-4">
            <AlertCircle className="h-4 w-4" />
            <AlertDescription>{error}</AlertDescription>
          </Alert>
        )}

        <div className="space-y-6">
          {/* Existing Members */}
          <div>
            <h3 className="text-sm font-medium text-slate-700 mb-3">Current Members</h3>
            <div className="space-y-3">
              {editedMembers.map((member, index) => (
                <div 
                  key={member.id} 
                  className={`p-4 rounded-lg border-2 transition-all ${
                    member._action === 'delete' 
                      ? 'border-red-200 bg-red-50 opacity-50' 
                      : member._action === 'update'
                      ? 'border-amber-200 bg-amber-50'
                      : 'border-slate-200 bg-slate-50'
                  }`}
                >
                  <div className="flex justify-between items-start mb-3">
                    <div className="flex items-center gap-2">
                      <span className="text-sm font-medium text-slate-700">
                        {member.is_owner ? 'Project Owner' : `Member ${index + 1}`}
                      </span>
                      {member.is_owner && (
                        <Badge variant="secondary" className="bg-slate-900 text-white">
                          Owner
                        </Badge>
                      )}
                      {member._action === 'update' && (
                        <Badge variant="secondary" className="bg-amber-100 text-amber-700">
                          Modified
                        </Badge>
                      )}
                    </div>
                    {!member.is_owner && (
                      <Button
                        variant="ghost"
                        size="sm"
                        onClick={() => markForDeletion(index)}
                        className={member._action === 'delete' ? 'text-emerald-600' : 'text-red-500'}
                      >
                        {member._action === 'delete' ? 'Undo' : <Trash2 className="w-4 h-4" />}
                      </Button>
                    )}
                  </div>
                  {member._action !== 'delete' && (
                    <div className="grid grid-cols-2 gap-3">
                      <div>
                        <Label className="text-xs">Name</Label>
                        <Input
                          value={member.name}
                          onChange={(e) => updateMember(index, 'name', e.target.value)}
                          disabled={member.is_owner}
                        />
                      </div>
                      <div>
                        <Label className="text-xs">Email</Label>
                        <Input
                          type="email"
                          value={member.email}
                          onChange={(e) => updateMember(index, 'email', e.target.value)}
                          disabled={member.is_owner}
                        />
                      </div>
                      <div className="col-span-2">
                        <Label className="text-xs">Skill</Label>
                        <Input
                          value={member.skill || ''}
                          onChange={(e) => updateMember(index, 'skill', e.target.value)}
                          placeholder="e.g., Design, Coding, Research"
                        />
                      </div>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>

          {/* New Members */}
          {newMembers.length > 0 && (
            <div>
              <h3 className="text-sm font-medium text-slate-700 mb-3">New Members</h3>
              <div className="space-y-3">
                {newMembers.map((member, index) => (
                  <div key={index} className="p-4 bg-emerald-50 border-2 border-emerald-200 rounded-lg">
                    <div className="flex justify-between items-start mb-3">
                      <Badge variant="secondary" className="bg-emerald-100 text-emerald-700">
                        New
                      </Badge>
                      <Button
                        variant="ghost"
                        size="sm"
                        onClick={() => removeNewMember(index)}
                        className="text-red-500 h-8 w-8 p-0"
                      >
                        <Trash2 className="w-4 h-4" />
                      </Button>
                    </div>
                    <div className="grid grid-cols-2 gap-3">
                      <div>
                        <Label className="text-xs">Name *</Label>
                        <Input
                          value={member.name}
                          onChange={(e) => updateNewMember(index, 'name', e.target.value)}
                          placeholder="John Doe"
                        />
                      </div>
                      <div>
                        <Label className="text-xs">Email *</Label>
                        <Input
                          type="email"
                          value={member.email}
                          onChange={(e) => updateNewMember(index, 'email', e.target.value)}
                          placeholder="john@gmail.com"
                        />
                      </div>
                      <div className="col-span-2">
                        <Label className="text-xs">Skill (optional)</Label>
                        <Input
                          value={member.skill}
                          onChange={(e) => updateNewMember(index, 'skill', e.target.value)}
                          placeholder="e.g., Design, Coding, Research"
                        />
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          <Button
            variant="outline"
            onClick={addNewMember}
            className="w-full"
          >
            <Plus className="w-4 h-4 mr-2" /> Add New Member
          </Button>

          <div className="flex justify-end gap-3 pt-4 border-t">
            <Button variant="outline" onClick={onClose}>
              Cancel
            </Button>
            <Button
              onClick={handleSubmit}
              disabled={isSubmitting}
              className="bg-slate-900 hover:bg-slate-800"
            >
              {isSubmitting ? (
                <>
                  <Loader2 className="w-4 h-4 mr-2 animate-spin" />
                  Saving...
                </>
              ) : (
                <>
                  <Save className="w-4 h-4 mr-2" />
                  Save Changes
                </>
              )}
            </Button>
          </div>
        </div>
      </DialogContent>
    </Dialog>
  );
}
